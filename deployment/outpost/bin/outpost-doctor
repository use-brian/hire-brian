#!/usr/bin/env bash
set -u

cleanup=no
case "${1:-}" in
  '') [ "$#" -eq 0 ] || { echo "Unexpected empty argument." >&2; exit 2; } ;;
  --cleanup-old-releases) cleanup=yes ;;
  --help|-h)
    echo "Usage: outpost-doctor [--cleanup-old-releases]"
    echo "After successful health checks, optionally delete all inactive managed releases (requires root)."
    exit 0 ;;
  *) echo "Usage: outpost-doctor [--cleanup-old-releases]" >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { echo "Too many arguments." >&2; exit 2; }

if [ "$cleanup" = yes ]; then
  [ "$(id -u)" -eq 0 ] || { echo "Release cleanup requires root." >&2; exit 1; }
  # Hold the update/connector lock through health checks and deletion.
  exec 9>/run/lock/use-brian-outpost-update.lock
  flock -n 9 || { echo "An Outpost update or connector change is running." >&2; exit 1; }
fi

failed=0
. /etc/use-brian-outpost/deploy.conf
units=(api auth app doc-sync browser-relay)
if [ "$ENABLE_DISCORD" = yes ]; then units+=(discord); fi
if [ "$ENABLE_WHATSAPP" = yes ]; then units+=(whatsapp); fi
if [ "$ENABLE_WECHAT" = yes ]; then units+=(wechat); fi
if [ "$ENABLE_FEISHU" = yes ]; then units+=(feishu); fi
if [ -e /etc/use-brian-outpost/browser-desktop ]; then units+=(browser-desktop); fi

check_url() {
  local name=$1 url=$2
  if curl --max-time 3 --fail --silent --show-error --output /dev/null "$url"; then
    printf '%-24s OK\n' "$name"
  else
    printf '%-24s FAILED (%s)\n' "$name" "$url"
    failed=1
  fi
}

for unit in "${units[@]}"; do
  if systemctl is-active --quiet "use-brian-outpost-$unit.service"; then
    printf '%-24s active\n' "$unit"
  else
    printf '%-24s INACTIVE\n' "$unit"
    failed=1
  fi
done

check_url api http://127.0.0.1:4000/health
check_url auth http://127.0.0.1:3005/health
check_url app http://127.0.0.1:3003/
check_url doc-sync http://127.0.0.1:8080/health
if [ "$ENABLE_DISCORD" = yes ]; then check_url discord http://127.0.0.1:8090/health; fi
if [ "$ENABLE_WHATSAPP" = yes ]; then check_url whatsapp http://127.0.0.1:8091/health; fi
check_url browser-relay http://127.0.0.1:8092/health
if [ "$ENABLE_WECHAT" = yes ]; then check_url wechat http://127.0.0.1:8093/health; fi
if [ "$ENABLE_FEISHU" = yes ]; then check_url feishu http://127.0.0.1:8095/health; fi
if [ "$cleanup" = yes ] && [ "$failed" -eq 0 ]; then
  releases=$(readlink -f /var/lib/use-brian-outpost/releases)
  active=$(readlink -f /var/lib/use-brian-outpost/platform)
  if [ -z "$releases" ] || [ -z "$active" ] || [ ! -d "$active" ] ||
     [ "$(dirname -- "$active")" != "$releases" ]; then
    echo "Cannot identify an active managed release; refusing cleanup." >&2
    exit 1
  fi
  for old in "$releases"/*; do
    [ -d "$old" ] && [ ! -L "$old" ] || continue
    [ "$old" != "$active" ] || continue
    echo ">> Removing inactive release: $old"
    if ! rm -rf -- "$old"; then
      echo "Failed to remove inactive release: $old" >&2
      failed=1
    fi
  done
fi
exit "$failed"
