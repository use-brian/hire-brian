#!/usr/bin/env bash
set -u

failed=0
. /etc/use-brian-outpost/deploy.conf
units=(api auth app doc-sync browser-relay)
if [ "$ENABLE_DISCORD" = yes ]; then units+=(discord); fi
if [ "$ENABLE_WHATSAPP" = yes ]; then units+=(whatsapp); fi
if [ "$ENABLE_WECHAT" = yes ]; then units+=(wechat); fi
if [ "$ENABLE_FEISHU" = yes ]; then units+=(feishu); fi
if [ -e /etc/use-brian-outpost/browser-desktop ]; then units+=(browser-desktop); fi

check_url() {
  local name=$1 url=$2
  if curl --max-time 3 --fail --silent --show-error --output /dev/null "$url"; then
    printf '%-24s OK\n' "$name"
  else
    printf '%-24s FAILED (%s)\n' "$name" "$url"
    failed=1
  fi
}

for unit in "${units[@]}"; do
  if systemctl is-active --quiet "use-brian-outpost-$unit.service"; then
    printf '%-24s active\n' "$unit"
  else
    printf '%-24s INACTIVE\n' "$unit"
    failed=1
  fi
done

check_url api http://127.0.0.1:4000/health
check_url auth http://127.0.0.1:3005/health
check_url app http://127.0.0.1:3003/
check_url doc-sync http://127.0.0.1:8080/health
if [ "$ENABLE_DISCORD" = yes ]; then check_url discord http://127.0.0.1:8090/health; fi
if [ "$ENABLE_WHATSAPP" = yes ]; then check_url whatsapp http://127.0.0.1:8091/health; fi
check_url browser-relay http://127.0.0.1:8092/health
if [ "$ENABLE_WECHAT" = yes ]; then check_url wechat http://127.0.0.1:8093/health; fi
if [ "$ENABLE_FEISHU" = yes ]; then check_url feishu http://127.0.0.1:8095/health; fi
exit "$failed"
