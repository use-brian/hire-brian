#!/usr/bin/env bash
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "Run outpost-update as root." >&2; exit 1; }
exec 9>/run/lock/use-brian-outpost-update.lock
flock -n 9 || { echo "Another Outpost update is running." >&2; exit 1; }
. /etc/use-brian-outpost/deploy.conf

data=/var/lib/use-brian-outpost
releases=$data/releases
release="$releases/$(date -u +%Y%m%dT%H%M%SZ)-$(date +%N)"
platform=$data/platform
units=(
  use-brian-outpost-api
  use-brian-outpost-auth
  use-brian-outpost-app
  use-brian-outpost-doc-sync
  use-brian-outpost-browser-relay
)
if [ "$ENABLE_DISCORD" = yes ]; then units+=(use-brian-outpost-discord); fi
if [ "$ENABLE_WHATSAPP" = yes ]; then units+=(use-brian-outpost-whatsapp); fi
if [ "$ENABLE_WECHAT" = yes ]; then units+=(use-brian-outpost-wechat); fi
if [ "$ENABLE_FEISHU" = yes ]; then units+=(use-brian-outpost-feishu); fi
if [ -e /etc/use-brian-outpost/browser-desktop ]; then units+=(use-brian-outpost-browser-desktop); fi

install -d -o "$BRIAN_USER" -g "$BRIAN_GROUP" -m 0750 "$releases" "$release"
case "$OUTPOST_SOURCE_MODE" in
  repository)
    ref=${1:-$BRIAN_REF}
    echo ">> Cloning $BRIAN_REPO at $ref"
    runuser -u "$BRIAN_USER" -- git clone --no-checkout "$BRIAN_REPO" "$release"
    runuser -u "$BRIAN_USER" -- git -C "$release" fetch --tags origin
    target=$ref
    if runuser -u "$BRIAN_USER" -- git -C "$release" show-ref --verify --quiet "refs/remotes/origin/$ref"; then target="origin/$ref"; fi
    runuser -u "$BRIAN_USER" -- git -C "$release" checkout --detach "$target"
    ;;
  directory)
    source_dir=${1:-$OUTPOST_SOURCE_DIR}
    source_dir=$(readlink -f "$source_dir")
    echo ">> Staging $source_dir into $release"
    rsync -a --delete \
      --exclude='.git/' --exclude='node_modules/' --exclude='dist/' --exclude='.next/' --exclude='.turbo/' \
      "$source_dir/" "$release/"
    ;;
  *) echo "Invalid OUTPOST_SOURCE_MODE in deploy.conf." >&2; exit 1 ;;
esac
chown -R "$BRIAN_USER:$BRIAN_GROUP" "$release"
for marker in package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json apps/api/package.json \
  apps/auth-web/package.json apps/app-web/package.json apps/doc-sync/package.json \
  apps/browser-relay/package.json packages/api/migrations; do
  [ -e "$release/$marker" ] || { echo "Outpost source is missing $marker." >&2; exit 1; }
done

echo ">> Installing and building native release"
INSTALL_BROWSER=no
if [ -e /etc/use-brian-outpost/browser-desktop ]; then INSTALL_BROWSER=yes; fi
runuser -u "$BRIAN_USER" -- env HOME="$data" \
  INSTALL_BROWSER="$INSTALL_BROWSER" \
  ENABLE_DISCORD="$ENABLE_DISCORD" ENABLE_WHATSAPP="$ENABLE_WHATSAPP" \
  ENABLE_WECHAT="$ENABLE_WECHAT" ENABLE_FEISHU="$ENABLE_FEISHU" \
  NEXT_PUBLIC_USEBRIAN_EDITION=outpost \
  NEXT_PUBLIC_PRIMARY_AUTH_URL="$AUTH_PORTAL_URL" \
  NEXT_PUBLIC_APP_URL="$AUTH_PORTAL_URL" \
  NEXT_PUBLIC_AUTHED_APP_URL="$APP_URL" \
  NEXT_PUBLIC_API_URL="$API_URL" \
  NEXT_PUBLIC_DOC_SYNC_URL="$DOC_SYNC_PUBLIC_URL" \
  bash -c '
    set -euo pipefail
    . /usr/local/lib/use-brian-outpost/native-build
    native_build_filters outpost
    build_native_release "$1"
  ' _ "$release"

echo ">> Stopping application writers"
systemctl stop "${units[@]}"

echo ">> Applying standalone Outpost migrations"
if ! runuser -u "$BRIAN_USER" -- bash -c '
  set -euo pipefail
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    key=${line%%=*}
    export "$key=${line#*=}"
  done < /etc/use-brian-outpost/migrate.env
  cd "$1"
  corepack pnpm --filter @use-brian/api migrate
' _ "$release"; then
  systemctl start "${units[@]}"
  echo "Migration failed; previous release was restarted." >&2
  exit 1
fi

/usr/local/lib/use-brian-outpost/grant-role

previous=$(readlink -f "$platform" 2>/dev/null || true)
ln -sfn "$release" "$data/platform.new"
mv -Tf "$data/platform.new" "$platform"

systemctl restart use-brian-outpost-api.service
if ! /usr/local/lib/use-brian-outpost/wait-for-api; then
  if [ -n "$previous" ] && [ -d "$previous" ]; then
    ln -sfn "$previous" "$data/platform.rollback"
    mv -Tf "$data/platform.rollback" "$platform"
    systemctl restart "${units[@]}"
  fi
  echo "API readiness failed; previous code was restored. Migrations were not rolled back." >&2
  exit 1
fi
systemctl restart "${units[@]:1}"

for _ in $(seq 1 60); do
  if outpost-doctor; then
    echo ">> Release healthy: $release"
    # Keep rollback code until health checks pass. Only remove a direct child
    # of the managed releases directory, never the active release or other data.
    if [ -n "$previous" ] && [ -d "$previous" ] &&
       [ "$(dirname -- "$previous")" = "$(readlink -f "$releases")" ] &&
       [ "$previous" != "$(readlink -f "$platform")" ]; then
      echo ">> Removing previous release: $previous"
      if ! rm -rf -- "$previous"; then
        echo "Warning: healthy release is active, but previous release cleanup failed: $previous" >&2
      fi
    fi
    exit 0
  fi
  sleep 2
done

if [ -n "$previous" ] && [ -d "$previous" ]; then
  ln -sfn "$previous" "$data/platform.rollback"
  mv -Tf "$data/platform.rollback" "$platform"
  systemctl restart "${units[@]}"
fi
echo "Release failed health checks; previous code was restored when available. Migrations were not rolled back." >&2
exit 1
