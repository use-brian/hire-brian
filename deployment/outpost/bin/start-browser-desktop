#!/usr/bin/env bash
set -euo pipefail

export DISPLAY=:1
Xvfb "$DISPLAY" -screen 0 1440x900x24 -nolisten tcp &
xvfb_pid=$!
trap 'kill "$xvfb_pid" "${xfce_pid:-}" "${chromium_pid:-}" "${vnc_pid:-}" 2>/dev/null || true' EXIT
for _ in $(seq 1 50); do xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break; sleep 0.1; done
xdpyinfo -display "$DISPLAY" >/dev/null
dbus-run-session -- startxfce4 &
xfce_pid=$!
sleep 2
chromium --user-data-dir=/var/lib/use-brian-outpost/chromium --no-first-run --no-default-browser-check \
  --load-extension=/var/lib/use-brian-outpost/platform/apps/browser-extension/dist &
chromium_pid=$!
x11vnc -display "$DISPLAY" -localhost -forever -shared -rfbport 5901 -rfbauth /etc/use-brian-outpost/vnc.pass &
vnc_pid=$!
while kill -0 "$xvfb_pid" "$xfce_pid" "$chromium_pid" "$vnc_pid" 2>/dev/null; do sleep 2; done
exit 1
