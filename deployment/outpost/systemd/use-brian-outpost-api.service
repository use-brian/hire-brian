[Unit]
Description=Use Brian Outpost API and workers
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=@BRIAN_USER@
Group=@BRIAN_GROUP@
WorkingDirectory=/var/lib/use-brian-outpost/platform
EnvironmentFile=/etc/use-brian-outpost/api.env
Environment=HOME=/var/lib/use-brian-outpost PORT=4000
ExecStart=/usr/bin/node apps/api/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/use-brian-outpost
MemoryMax=4G
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
