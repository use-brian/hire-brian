[Unit]
Description=Use Brian Outpost web application
After=network-online.target use-brian-outpost-api.service
Requires=use-brian-outpost-api.service

[Service]
User=@BRIAN_USER@
Group=@BRIAN_GROUP@
WorkingDirectory=/var/lib/use-brian-outpost/platform/apps/app-web
EnvironmentFile=/etc/use-brian-outpost/app.env
Environment=HOME=/var/lib/use-brian-outpost PORT=3003 INTERNAL_API_URL=http://127.0.0.1:4000
ExecStartPre=/usr/local/lib/use-brian-outpost/wait-for-api
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3003
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/use-brian-outpost
MemoryMax=2G

[Install]
WantedBy=multi-user.target
