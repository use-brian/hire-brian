[Unit]
Description=Use Brian Outpost WeChat connector
After=network-online.target use-brian-outpost-api.service
Requires=use-brian-outpost-api.service

[Service]
User=@BRIAN_USER@
Group=@BRIAN_GROUP@
WorkingDirectory=/var/lib/use-brian-outpost/platform
EnvironmentFile=/etc/use-brian-outpost/wechat.env
Environment=HOME=/var/lib/use-brian-outpost PORT=8093 USEBRIAN_API_URL=http://127.0.0.1:4000
ExecStartPre=/usr/local/lib/use-brian-outpost/wait-for-api
ExecStart=/usr/bin/node apps/wechat-connector/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/use-brian-outpost
MemoryMax=512M

[Install]
WantedBy=multi-user.target
