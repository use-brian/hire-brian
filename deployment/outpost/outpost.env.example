OUTPOST_SOURCE_MODE=repository
BRIAN_REPO=https://github.com/use-brian/use-brian.git
BRIAN_REF=main
# Alternative:
# OUTPOST_SOURCE_MODE=directory
# OUTPOST_SOURCE_DIR=/srv/use-brian
BRIAN_USER=brian
INSTALL_POSTGRES=yes
INSTALL_LIBREOFFICE=yes
INSTALL_BROWSER=no
ENABLE_DISCORD=yes
ENABLE_WHATSAPP=yes
ENABLE_WECHAT=yes
ENABLE_FEISHU=yes
SSH_PORT=22

APP_URL=https://app.customer.example
API_URL=https://api.customer.example
AUTH_PORTAL_URL=https://auth.customer.example
DOC_SYNC_PUBLIC_URL=wss://docs.customer.example
COOKIE_DOMAIN=.customer.example
TRUST_PROXY_HEADERS=false
REVERSE_PROXY_SETUP=default

MODEL_PROVIDER=gemini
GEMINI_API_KEY=replace
# Alternatives:
# MODEL_PROVIDER=dashscope
# DASHSCOPE_API_KEY=replace
# DASHSCOPE_BASE_URL=
# MODEL_PROVIDER=vertex
# VERTEX_PROJECT_ID=my-project
# VERTEX_LOCATION=asia-east2
# MODEL_PROVIDER=openai-codex

OUTPOST_AUTH_METHOD=email
OUTPOST_AUTH_BOOTSTRAP_EMAILS=admin@customer.example
SMTP_HOST=smtp.customer.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@customer.example
SMTP_PASSWORD=replace
EMAIL_FROM_ADDRESS=mailer@customer.example

# External database alternative:
# INSTALL_POSTGRES=no
# DATABASE_URL=postgresql://owner:password@db.example:5432/brian?sslmode=verify-full
# DATABASE_URL_APP=postgresql://app:password@db.example:5432/brian?sslmode=verify-full
