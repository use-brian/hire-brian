# Pin a matching published release or sha-* tag for every application image.
BRIAN_IMAGE_TAG=latest
PUBLIC_APP_URL=http://localhost:3003
PUBLIC_API_URL=http://localhost:4000
PUBLIC_DOC_SYNC_URL=ws://localhost:8080
# My Browser limitation: API uses this for HTTP transport AND advertised WS.
# Container localhost cannot reach the host relay port. For My Browser, use an
# HTTPS relay origin reachable by both API and browser; see README.md.
# This default remains allowed for standard local OSS installation.
PUBLIC_RELAY_URL=http://localhost:8094
COOKIE_DOMAIN=

# Default: sign in to ChatGPT/Codex from Settings; no model API key required.
USEBRIAN_PREFERRED_PROVIDER=openai-codex
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
APP_HOSTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
FATHOM_CLIENT_ID=
FATHOM_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# install.sh replaces these with independent random values. For manual setup,
# use hex database passwords (URI-safe) and 32-byte base64 encryption keys.
POSTGRES_PASSWORD=replace-owner-database-password
APP_DATABASE_PASSWORD=replace-app-database-password
JWT_SECRET=replace-jwt-secret
DOC_SYNC_SECRET=replace-doc-sync-secret
CHANNEL_CREDENTIAL_KEY=replace-channel-credential-key
DISCORD_CONNECTOR_SECRET=replace-discord-connector-secret
WA_CONNECTOR_SECRET=replace-wa-connector-secret
BROWSER_RELAY_SECRET=replace-browser-relay-secret
WECHAT_CONNECTOR_SECRET=replace-wechat-connector-secret
FEISHU_CONNECTOR_SECRET=replace-feishu-connector-secret
BROWSER_VAULT_ENCRYPTION_KEY=replace-browser-vault-key
BROWSER_CREDENTIAL_ENCRYPTION_KEY=replace-browser-credential-key
LLM_PROVIDER_KEY_ENCRYPTION_KEY=replace-llm-provider-key
