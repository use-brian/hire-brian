# Source and published auxiliary-image versions. Pin BRIAN_REF to a release tag
# or commit for reproducible installs; match BRIAN_IMAGE_TAG when one exists.
BRIAN_REPO=https://github.com/use-brian/use-brian.git
BRIAN_REF=main
BRIAN_IMAGE_TAG=latest

# Create DNS A/AAAA records for all four names before starting Caddy.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
DOC_SYNC_DOMAIN=docs.example.com
RELAY_DOMAIN=relay.example.com
COOKIE_DOMAIN=.example.com

# Protects the only route that can mint the OSS owner's first session. Generate
# a bcrypt hash with the command documented in README.md.
OWNER_USERNAME=brian
OWNER_PASSWORD_HASH=replace-caddy-bcrypt-hash

# The default starts without an API key and lets the owner sign in to ChatGPT
# from Settings. To use Gemini instead, select gemini and provide its key.
USEBRIAN_PREFERRED_PROVIDER=openai-codex
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Replace every value below. deployment/compose/install.sh generates these.
POSTGRES_PASSWORD=replace-owner-database-password
APP_DATABASE_PASSWORD=replace-app-database-password
JWT_SECRET=replace-jwt-secret
DOC_SYNC_SECRET=replace-doc-sync-secret
CHANNEL_CREDENTIAL_KEY=replace-base64-key
DISCORD_CONNECTOR_SECRET=replace-discord-secret
WA_CONNECTOR_SECRET=replace-whatsapp-secret
BROWSER_RELAY_SECRET=replace-browser-relay-secret
WECHAT_CONNECTOR_SECRET=replace-wechat-secret
FEISHU_CONNECTOR_SECRET=replace-feishu-secret
BROWSER_VAULT_ENCRYPTION_KEY=replace-base64-key
BROWSER_CREDENTIAL_ENCRYPTION_KEY=replace-base64-key
LLM_PROVIDER_KEY_ENCRYPTION_KEY=replace-base64-key
