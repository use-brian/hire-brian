# Loaded AFTER .env in outpost mode. Do not duplicate database/encryption secrets.
# Your external reverse proxy provides TLS for these sibling, single-level hosts.
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_DOC_SYNC_URL=wss://docs.example.com
# Must be reachable from both the API container and the user's browser.
# The external proxy must support relay HTTP transport and WebSockets.
PUBLIC_RELAY_URL=https://relay.example.com
AUTH_PORTAL_URL=https://auth.example.com
PUBLIC_PRIMARY_AUTH_URL=https://auth.example.com
COOKIE_DOMAIN=.example.com

# Real administrator mailboxes, comma-separated. Does NOT transfer OSS owner data.
OUTPOST_AUTH_BOOTSTRAP_EMAILS=
# Email login needs a reachable SMTP server, real credentials and approved sender.
# Empty required values intentionally fail preflight.
OUTPOST_AUTH_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# Optional OIDC: register a real client with redirect URI
# https://auth.example.com/api/auth/oidc/callback before enabling.
OUTPOST_AUTH_OIDC_ENABLED=false
OUTPOST_OIDC_ISSUER_URL=
OUTPOST_OIDC_CLIENT_ID=
OUTPOST_OIDC_CLIENT_SECRET=
OUTPOST_OIDC_PROVIDER_NAME=
# Generate once with openssl rand -hex 32 (required for OIDC).
OUTPOST_AUTH_BRIDGE_SECRET=
OUTPOST_OIDC_ALLOWED_ENDPOINT_ORIGINS=
OUTPOST_OIDC_EMAIL_VERIFICATION=claim
OUTPOST_OIDC_SUBJECT_IDENTITY_ENABLED=false
OUTPOST_OIDC_ENROLLMENT_MODE=invite_only
# Mapped enrollment requires real JSON referencing EXISTING workspace IDs.
# Single-quote values containing $ to prevent Compose interpolation.
OUTPOST_OIDC_WORKSPACE_MAPPINGS=
