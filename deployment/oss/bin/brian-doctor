#!/usr/bin/env bash
set -u

failed=0
. /etc/brian/deploy.conf
check_url() {
  local name=$1 url=$2
  if curl --max-time 2 --fail --silent --show-error --output /dev/null "$url"; then
    printf '%-24s OK\n' "$name"
  else
    printf '%-24s FAILED (%s)\n' "$name" "$url"
    failed=1
  fi
}

units=(brian-api brian-app-web brian-doc-sync brian-browser-relay)
if [ "$ENABLE_DISCORD" = yes ]; then units+=(brian-discord-connector); fi
if [ "$ENABLE_WHATSAPP" = yes ]; then units+=(brian-wa-connector); fi
if [ "$ENABLE_WECHAT" = yes ]; then units+=(brian-wechat-connector); fi
if [ "$ENABLE_FEISHU" = yes ]; then units+=(brian-feishu-connector); fi
for unit in "${units[@]}"; do
  if systemctl is-active --quiet "$unit"; then
    printf '%-24s active\n' "$unit"
  else
    printf '%-24s INACTIVE\n' "$unit"
    failed=1
  fi
done

check_url api http://127.0.0.1:4000/health
check_url app-web http://127.0.0.1:3003/
check_url doc-sync http://127.0.0.1:8080/health
if [ "$ENABLE_DISCORD" = yes ]; then check_url discord-connector http://127.0.0.1:8090/health; fi
if [ "$ENABLE_WHATSAPP" = yes ]; then check_url whatsapp-connector http://127.0.0.1:8091/health; fi
check_url browser-relay http://127.0.0.1:8092/health
if [ "$ENABLE_WECHAT" = yes ]; then check_url wechat-connector http://127.0.0.1:8093/health; fi
if [ "$ENABLE_FEISHU" = yes ]; then check_url feishu-connector http://127.0.0.1:8095/health; fi
exit "$failed"
