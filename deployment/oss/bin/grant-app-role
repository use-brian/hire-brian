#!/usr/bin/env bash
set -euo pipefail

runuser -u postgres -- psql --dbname=brian --set=ON_ERROR_STOP=1 <<'SQL'
GRANT CONNECT ON DATABASE brian TO app_user;
GRANT USAGE ON SCHEMA public TO app_user;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_user;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_user;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO app_user;
ALTER DEFAULT PRIVILEGES FOR ROLE brian IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user;
ALTER DEFAULT PRIVILEGES FOR ROLE brian IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO app_user;
ALTER DEFAULT PRIVILEGES FOR ROLE brian IN SCHEMA public GRANT EXECUTE ON FUNCTIONS TO app_user;
SQL
