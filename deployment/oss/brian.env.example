NODE_ENV=production
# Installer setting (stored in deploy.conf): BRIAN_USER=brian
USEBRIAN_EDITION=oss
USEBRIAN_PREFERRED_PROVIDER=gemini
GEMINI_API_KEY=replace
# Installer settings (stored in deploy.conf):
# ENABLE_DISCORD=yes
# ENABLE_WHATSAPP=yes
# ENABLE_WECHAT=yes
# ENABLE_FEISHU=yes
DATABASE_URL=postgresql://owner:password@database.example:5432/brian?sslmode=require
DATABASE_URL_APP=postgresql://app_user:password@database.example:5432/brian?sslmode=require
# Installer-only override for intentionally non-TLS external URLs:
# ALLOW_INSECURE_EXTERNAL_POSTGRES=yes
APP_URL=https://app.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_DOC_SYNC_URL=wss://docs.example.com
COOKIE_DOMAIN=.example.com
JWT_SECRET=replace-me
DOC_SYNC_SECRET=replace-me
CHANNEL_CREDENTIAL_KEY=replace-me
DISCORD_CONNECTOR_SECRET=replace-me
WA_CONNECTOR_SECRET=replace-me
BROWSER_RELAY_SECRET=replace-me
WECHAT_CONNECTOR_SECRET=replace-me
FEISHU_CONNECTOR_SECRET=replace-me
BROWSER_VAULT_ENCRYPTION_KEY=replace-with-base64-32-byte-key
BROWSER_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
LLM_PROVIDER_KEY_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
