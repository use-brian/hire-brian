[Unit]
Description=Brian WhatsApp connector
After=network-online.target postgresql.service brian-api.service
Wants=network-online.target

[Service]
User=brian
Group=brian
WorkingDirectory=/var/lib/brian/platform
EnvironmentFile=/etc/brian/brian.env
Environment=HOME=/var/lib/brian PORT=8091 USEBRIAN_API_URL=http://127.0.0.1:4000
ExecStartPre=/usr/local/lib/brian/wait-for-api
ExecStart=/usr/bin/node apps/wa-connector/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/brian
MemoryMax=1G

[Install]
WantedBy=multi-user.target
