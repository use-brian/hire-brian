[Unit]
Description=Brian Chromium virtual desktop
After=network-online.target
Wants=network-online.target

[Service]
User=@BRIAN_USER@
Group=@BRIAN_GROUP@
Environment=HOME=/var/lib/brian DISPLAY=:1
ExecStart=/usr/local/lib/brian/start-browser-desktop
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/brian -/tmp/.X11-unix
MemoryMax=2G

[Install]
WantedBy=multi-user.target
